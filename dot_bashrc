# shellcheck shell=bash
# ─────────────────────────────────────────────
# INTERACTIVE SHELL ONLY
# ─────────────────────────────────────────────
[[ $- == *i* ]] || return


# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
export EDITOR="vim"
export VISUAL="$EDITOR"

export KUBECONFIG="$HOME/.kube/config"
export GODEBUG="tlsmlkem=0"

export GREP_COLORS='ms=01;31:mc=01;31:sl=:cx=:fn=35:ln=32:bn=32:se=36'

export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.terragrunt/bin:$PATH"
export PATH="/usr/local/go/bin:$PATH"


# ─────────────────────────────────────────────
# OH MY BASH
# ─────────────────────────────────────────────
export OSH="$HOME/.oh-my-bash"

OSH_THEME="powerline-icon"

DISABLE_AUTO_TITLE="false"
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

completions=(
  git
  ssh
  go
)

aliases=(
  general
)

plugins=(
  git
  bashmarks
)


# ─────────────────────────────────────────────
# KUBERNETES PROMPT
# ─────────────────────────────────────────────
# Toute la configuration du thème doit être définie
# avant de charger oh-my-bash.sh.

KUBE_PS1_SCRIPT="$OSH/custom/kube-ps1/kube-ps1.sh"

if [[ -r "$KUBE_PS1_SCRIPT" ]]; then
  source "$KUBE_PS1_SCRIPT"

  # Conserve une copie interne de kube_ps1 pour le thème Powerline.
  if declare -F kube_ps1 >/dev/null 2>&1; then
    eval "_kube_ps1_render() $(declare -f kube_ps1 | tail -n +2)"
    unset -f kube_ps1
  fi

  KUBE_PS1_SYMBOL_COLOR=""
  KUBE_PS1_CTX_COLOR=""
  KUBE_PS1_NS_COLOR=""
  KUBE_PS1_PREFIX_COLOR=""
  KUBE_PS1_SUFFIX_COLOR=""
  KUBE_PS1_BG_COLOR=""

  KUBE_PS1_SEPARATOR=" "
  KUBE_PS1_NS_ENABLE=true
  KUBE_PS1_SYMBOL_CUSTOM="img"

  KUBE_THEME_PROMPT_COLOR=237

  _kube_short_cluster() {
    printf '%s\n' "${1#*@}"
  }

  KUBE_PS1_CLUSTER_FUNCTION=_kube_short_cluster

  __powerline_kube_prompt() {
    local kube

    declare -F _kube_ps1_render >/dev/null 2>&1 || return

    kube="$(
      _kube_ps1_render |
        sed $'s/\033\\[[0-9;]*m//g'
    )"

    [[ -n "$kube" ]] || return

    _omb_util_print "${kube}|${KUBE_THEME_PROMPT_COLOR}"
  }
fi

POWERLINE_PROMPT="user_info scm python_venv ruby cwd kube"

POWERLINE_PROMPT_USER_INFO_MODE="sudo"

OMB_THEME_POWERLINE_ICON_USER="🧬"
OMB_THEME_POWERLINE_ICON_CLOCK=""


# Powerline doit être chargé avant Oh My Bash.
if [[ -r /usr/share/powerline/bindings/bash/powerline.sh ]]; then
  source /usr/share/powerline/bindings/bash/powerline.sh
fi

if [[ -r "$OSH/oh-my-bash.sh" ]]; then
  source "$OSH/oh-my-bash.sh"
else
  printf 'Oh My Bash introuvable : %s\n' "$OSH/oh-my-bash.sh" >&2
fi


# ─────────────────────────────────────────────
# SHELL OPTIONS
# ─────────────────────────────────────────────
shopt -s autocd
shopt -s cdspell
shopt -s histappend
shopt -s checkwinsize

# Recherche d'historique selon ce qui est déjà saisi.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Complétion avec menu sur Tab.
bind 'set show-all-if-ambiguous off'
bind 'TAB:menu-complete'


# ─────────────────────────────────────────────
# HISTORY
# ─────────────────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL="ignoreboth:erasedups"

# Ne remets pas HISTTIMEFORMAT globalement :
# certaines intégrations FZF anciennes le gèrent mal.
unset HISTTIMEFORMAT

# Enregistre et relit immédiatement l'historique sans écraser
# un éventuel PROMPT_COMMAND existant.
case ";${PROMPT_COMMAND:-};" in
  *";history -a; history -n;"*)
    ;;
  *)
    PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    ;;
esac

history-time() {
  HISTTIMEFORMAT="%d/%m %H:%M  " builtin history "$@"
}


# ─────────────────────────────────────────────
# EXTERNAL TOOLS
# ─────────────────────────────────────────────

# Homebrew
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# Cargo
if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# Fonctions personnelles
if [[ -r "$HOME/.bash_func" ]]; then
  source "$HOME/.bash_func"
fi

# Profils cloud personnels
if [[ -r "$HOME/.config/cloud-profiles/cloud.sh" ]]; then
  source "$HOME/.config/cloud-profiles/cloud.sh"
fi


# ─────────────────────────────────────────────
# COMPLETIONS
# ─────────────────────────────────────────────
BASH_COMPLETION_CACHE="$HOME/.cache/bash-completions"
mkdir -p "$BASH_COMPLETION_CACHE"

_completion_cache() {
  local name="$1"
  shift

  local cache="$BASH_COMPLETION_CACHE/$name"
  local today

  today="$(date +%F)"

  if [[ ! -s "$cache" ]] ||
     [[ "$(date -r "$cache" +%F 2>/dev/null)" != "$today" ]]; then
    "$@" >| "$cache" 2>/dev/null || {
      rm -f "$cache"
      return 0
    }
  fi

  [[ -r "$cache" ]] && source "$cache"
}

command -v kubectl >/dev/null 2>&1 &&
  _completion_cache kubectl kubectl completion bash

command -v helm >/dev/null 2>&1 &&
  _completion_cache helm helm completion bash

command -v argocd >/dev/null 2>&1 &&
  _completion_cache argocd argocd completion bash

command -v stern >/dev/null 2>&1 &&
  _completion_cache stern stern --completion bash

command -v glab >/dev/null 2>&1 &&
  _completion_cache glab glab completion

command -v ovhcloud >/dev/null 2>&1 &&
  _completion_cache ovhcloud ovhcloud completion bash

command -v minikube >/dev/null 2>&1 &&
  _completion_cache minikube minikube completion bash

command -v kubara >/dev/null 2>&1 &&
  _completion_cache kubara kubara completion bash

command -v chezmoi >/dev/null 2>&1 &&
  _completion_cache chezmoi chezmoi completion bash

command -v kube-bench >/dev/null 2>&1 &&
  _completion_cache kube-bench kube-bench completion bash

command -v task >/dev/null 2>&1 &&
  _completion_cache task task --completion bash

command -v scw >/dev/null 2>&1 &&
  _completion_cache scw scw autocomplete script shell=bash

command -v cosign >/dev/null 2>&1 &&
  _completion_cache cosign cosign completion bash


# Python argcomplete
if command -v register-python-argcomplete >/dev/null 2>&1; then
  command -v ansible >/dev/null 2>&1 &&
    _completion_cache ansible \
      register-python-argcomplete ansible

  command -v ansible-playbook >/dev/null 2>&1 &&
    _completion_cache ansible-playbook \
      register-python-argcomplete ansible-playbook

  command -v ansible-galaxy >/dev/null 2>&1 &&
    _completion_cache ansible-galaxy \
      register-python-argcomplete ansible-galaxy
fi


# Molecule
if command -v molecule >/dev/null 2>&1; then
  MOLECULE_CACHE="$BASH_COMPLETION_CACHE/molecule"

  if [[ ! -s "$MOLECULE_CACHE" ]] ||
     [[ "$(date -r "$MOLECULE_CACHE" +%F 2>/dev/null)" != "$(date +%F)" ]]; then
    _MOLECULE_COMPLETE=bash_source molecule \
      >| "$MOLECULE_CACHE" 2>/dev/null || {
        rm -f "$MOLECULE_CACHE"
      }
  fi

  [[ -r "$MOLECULE_CACHE" ]] && source "$MOLECULE_CACHE"

  unset MOLECULE_CACHE
fi


# Nerdctl fournit parfois directement un fichier.
if [[ -r "$HOME/.local/share/bash-completion/completions/nerdctl" ]]; then
  source "$HOME/.local/share/bash-completion/completions/nerdctl"
fi


# Complétions basées sur un exécutable dédié.
if [[ -x "$HOME/.terragrunt/bin/terragrunt" ]]; then
  complete \
    -C "$HOME/.terragrunt/bin/terragrunt" \
    terragrunt
fi

if [[ -x /usr/local/bin/aws_completer ]]; then
  complete -C /usr/local/bin/aws_completer aws
elif command -v aws_completer >/dev/null 2>&1; then
  complete -C "$(command -v aws_completer)" aws
fi


# ─────────────────────────────────────────────
# ALIASES AND FUNCTIONS
# ─────────────────────────────────────────────

# Eza
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias ll='eza -lahF --icons --color=auto'
else
  alias ls='ls --color=auto'
  alias ll='ls -lahF --color=auto'
fi

alias ..='cd ..'
alias ...='cd ../..'

alias grep='grep --color=auto'
alias ports='ss -tulpn'
alias myip='curl -fsS --max-time 5 ifconfig.me'

if command -v btop >/dev/null 2>&1; then
  alias top='btop'
fi

if command -v batcat >/dev/null 2>&1; then
  alias cat='batcat --style=plain'
elif command -v bat >/dev/null 2>&1; then
  alias cat='bat --style=plain'
fi

alias salut='topgrade --disable containers -c --yes'

setK3S() {
  export KUBECONFIG="/etc/rancher/k3s/k3s.yaml"
}

unsetK3S() {
  export KUBECONFIG="$HOME/.kube/config"
}

please_last() {
  local previous_command

  previous_command="$(fc -ln -1)"
  [[ -n "$previous_command" ]] || return 1

  eval "sudo $previous_command"
}

alias gcl='gitlab-ci-local --home ~/.gitlab-ci-local'


# Kubernetes
alias k='kubectl'

if declare -F __start_kubectl >/dev/null 2>&1; then
  complete -o default -F __start_kubectl k
fi


# Kubeseal
alias kubeseal='kubeseal --cert ~/.kube/sealed-secrets-cert.pem'


# Ansible
alias ansible-env='source ~/.venv/ansible/bin/activate'


# OpenStack
alias os='openstack'

if declare -F _openstack >/dev/null 2>&1; then
  complete -o default -F _openstack os
fi


# ─────────────────────────────────────────────
# FZF
# ─────────────────────────────────────────────
# Une seule source FZF. Ne charge pas aussi manuellement
# ~/.fzf/shell/key-bindings.bash ailleurs.
if [[ -r "$HOME/.fzf.bash" ]]; then
  source "$HOME/.fzf.bash"
fi

export FZF_DEFAULT_OPTS="
  --height 50%
  --layout=reverse
  --border
  --color='fg:#d0d0d0,bg:#121212,hl:#5f87af'
  --color='fg+:#d0d0d0,bg+:#262626,hl+:#5fd7ff'
  --color='info:#afaf87,prompt:#d7005f,pointer:#af5fff'
  --color='marker:#87ff00,spinner:#af5fff,header:#87afaf'
"


# ─────────────────────────────────────────────
# EXTRA COMPLETION FILES
# ─────────────────────────────────────────────
if [[ -d "$HOME/.bash_completion.d" ]]; then
  for completion_file in "$HOME"/.bash_completion.d/*.bash; do
    [[ -r "$completion_file" ]] && source "$completion_file"
  done

  unset completion_file
fi


# ─────────────────────────────────────────────
# LOCAL MACHINE CONFIGURATION
# ─────────────────────────────────────────────
if [[ -r "$HOME/.bashrc.local" ]]; then
  source "$HOME/.bashrc.local"
fi

if [[ -r "$HOME/.config/openstack/openrc.sh" ]]; then
  source "$HOME/.config/openstack/openrc.sh"
fi


# ─────────────────────────────────────────────
# TERMINAL WELCOME
# ─────────────────────────────────────────────
# Seulement dans le premier shell local, pas en SSH ni dans les sous-shells.
if [[ -z "${SSH_CONNECTION:-}" ]] &&
   [[ ${SHLVL:-1} -eq 1 ]] &&
   [[ -t 1 ]] &&
   command -v figlet >/dev/null 2>&1; then
  clear

  figlet -f slant "Linux"
  figlet -f slant "For the win"

  printf '%s\n' \
    '🐧 Welcome back, kernel enjoyer.' \
    '💀 No GUI panic, only shell power.'
fi
