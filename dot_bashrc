# shellcheck shell=bash
# ─────────────────────────────────────────────
# INTERACTIVE SHELL ONLY
# ─────────────────────────────────────────────
[[ $- == *i* ]] || return


# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
export EDITOR="vim"
export VISUAL="$EDITOR"

export KUBECONFIG="$HOME/.kube/config"
export GODEBUG="tlsmlkem=0"

export GREP_COLORS='ms=01;31:mc=01;31:sl=:cx=:fn=35:ln=32:bn=32:se=36'

export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.terragrunt/bin:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"
export PATH="/usr/local/go/bin:$PATH"


# ─────────────────────────────────────────────
# OH MY BASH
# ─────────────────────────────────────────────
export OSH="$HOME/.oh-my-bash"

OSH_THEME="minimal"

DISABLE_AUTO_TITLE="false"
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

completions=(
  git
  ssh
  go
)

aliases=(
  general
)

plugins=(
  git
  bashmarks
)


# ─────────────────────────────────────────────
# KUBERNETES PROMPT
# ─────────────────────────────────────────────
# La configuration doit être définie avant de charger Oh My Bash.

KUBE_PS1_SCRIPT="$OSH/custom/kube-ps1/kube-ps1.sh"

if [[ -r "$KUBE_PS1_SCRIPT" ]]; then
  source "$KUBE_PS1_SCRIPT"

  KUBE_PS1_SYMBOL_COLOR=""
  KUBE_PS1_CTX_COLOR=""
  KUBE_PS1_NS_COLOR=""
  KUBE_PS1_PREFIX_COLOR=""
  KUBE_PS1_SUFFIX_COLOR=""
  KUBE_PS1_BG_COLOR=""

  KUBE_PS1_SEPARATOR=" "
  KUBE_PS1_NS_ENABLE=true
  KUBE_PS1_SYMBOL_CUSTOM="☸"
  KUBE_PS1_PREFIX=""
  KUBE_PS1_SUFFIX=""

  _kube_short_cluster() {
    printf '%s\n' "${1#*@}"
  }

  KUBE_PS1_CLUSTER_FUNCTION=_kube_short_cluster
fi
unset KUBE_PS1_SCRIPT

if [[ -r "$OSH/oh-my-bash.sh" ]]; then
  source "$OSH/oh-my-bash.sh"
else
  printf 'Oh My Bash introuvable : %s\n' "$OSH/oh-my-bash.sh" >&2
fi

# Le thème minimal utilise \W (dernier dossier uniquement) par défaut.
# Utilise \w sans PROMPT_DIRTRIM pour afficher tous les dossiers du chemin.
if [[ "$OSH_THEME" == "minimal" ]] &&
   declare -F _omb_theme_PROMPT_COMMAND >/dev/null 2>&1; then
  unset PROMPT_DIRTRIM

  _omb_theme_PROMPT_COMMAND() {
    PS1="$(scm_prompt_info)${_omb_prompt_reset_color} ${_omb_prompt_teal}\w${_omb_prompt_reset_color} "
  }
fi

# Enrichit le thème minimal sans dépendre de Powerline.
if [[ "$OSH_THEME" == "minimal" ]] &&
   declare -F kube_ps1 >/dev/null 2>&1 &&
   declare -F _omb_util_add_prompt_command >/dev/null 2>&1; then
  _minimal_kube_prompt_command() {
    local kube

    kube="$(kube_ps1)"
    if [[ -n "$kube" ]]; then
      PS1="${PS1% } ${_omb_prompt_purple}${kube}${_omb_prompt_reset_color} "
    fi
  }

  _omb_util_add_prompt_command _minimal_kube_prompt_command
fi


# ─────────────────────────────────────────────
# SHELL OPTIONS
# ─────────────────────────────────────────────
shopt -s autocd
shopt -s cdspell
shopt -s histappend
shopt -s checkwinsize

# Recherche d'historique selon ce qui est déjà saisi.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Complétion avec menu sur Tab.
bind 'set show-all-if-ambiguous off'
bind 'TAB:menu-complete'


# ─────────────────────────────────────────────
# HISTORY
# ─────────────────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL="ignoreboth:erasedups"
# Ignore les wrappers techniques injectés par certains lanceurs de terminal.
HISTIGNORE="${HISTIGNORE:+${HISTIGNORE}:}eval -- \$'*"

# Ne remets pas HISTTIMEFORMAT globalement :
# certaines intégrations FZF anciennes le gèrent mal.
unset HISTTIMEFORMAT

# Enregistre et relit immédiatement l'historique sans écraser
# un éventuel PROMPT_COMMAND existant.
case ";${PROMPT_COMMAND:-};" in
  *";history -a; history -n;"*)
    ;;
  *)
    PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    ;;
esac

history-time() {
  HISTTIMEFORMAT="%d/%m %H:%M  " builtin history "$@"
}


# ─────────────────────────────────────────────
# EXTERNAL TOOLS
# ─────────────────────────────────────────────

# Homebrew
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

  if [[ -r "$HOMEBREW_PREFIX/etc/bash_completion.d/brew" ]]; then
    source "$HOMEBREW_PREFIX/etc/bash_completion.d/brew"
  fi
fi

# Zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# Cargo
if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# Fonctions personnelles
if [[ -r "$HOME/.bash_func" ]]; then
  source "$HOME/.bash_func"
fi

# Profils cloud personnels
if [[ -r "$HOME/.config/cloud-profiles/cloud.sh" ]]; then
  source "$HOME/.config/cloud-profiles/cloud.sh"
fi

#
if [[ -d "$HOME/.bash_functions.d" ]]; then
  for function_file in "$HOME"/.bash_functions.d/*.sh; do
    [[ -r "$function_file" ]] && source "$function_file"
  done
  unset function_file
fi

# ─────────────────────────────────────────────
# COMPLETIONS
# ─────────────────────────────────────────────
BASH_COMPLETION_CACHE="$HOME/.cache/bash-completions"
mkdir -p "$BASH_COMPLETION_CACHE"

_completion_cache() {
  local name="$1"
  shift

  local cache="$BASH_COMPLETION_CACHE/$name"
  local today

  today="$(date +%F)"

  if [[ ! -s "$cache" ]] ||
     [[ "$(date -r "$cache" +%F 2>/dev/null)" != "$today" ]]; then
    "$@" >| "$cache" 2>/dev/null || {
      rm -f "$cache"
      return 0
    }
  fi

  [[ -r "$cache" ]] && source "$cache"
}

command -v kubectl >/dev/null 2>&1 &&
  _completion_cache kubectl kubectl completion bash

command -v helm >/dev/null 2>&1 &&
  _completion_cache helm helm completion bash

command -v argocd >/dev/null 2>&1 &&
  _completion_cache argocd argocd completion bash

command -v stern >/dev/null 2>&1 &&
  _completion_cache stern stern --completion bash

command -v glab >/dev/null 2>&1 &&
  _completion_cache glab glab completion

command -v ovhcloud >/dev/null 2>&1 &&
  _completion_cache ovhcloud ovhcloud completion bash

command -v minikube >/dev/null 2>&1 &&
  _completion_cache minikube minikube completion bash

command -v kubara >/dev/null 2>&1 &&
  _completion_cache kubara kubara completion bash

command -v chezmoi >/dev/null 2>&1 &&
  _completion_cache chezmoi chezmoi completion bash

command -v kube-bench >/dev/null 2>&1 &&
  _completion_cache kube-bench kube-bench completion bash

command -v task >/dev/null 2>&1 &&
  _completion_cache task task --completion bash

command -v scw >/dev/null 2>&1 &&
  _completion_cache scw scw autocomplete script shell=bash

command -v cosign >/dev/null 2>&1 &&
  _completion_cache cosign cosign completion bash

command -v velero >/dev/null 2>&1 &&
  _completion_cache velero velero completion bash

command -v dive >/dev/null 2>&1 &&
  _completion_cache dive dive completion bash

# Python argcomplete
if command -v register-python-argcomplete >/dev/null 2>&1; then
  command -v ansible >/dev/null 2>&1 &&
    _completion_cache ansible \
      register-python-argcomplete ansible

  command -v ansible-playbook >/dev/null 2>&1 &&
    _completion_cache ansible-playbook \
      register-python-argcomplete ansible-playbook

  command -v ansible-galaxy >/dev/null 2>&1 &&
    _completion_cache ansible-galaxy \
      register-python-argcomplete ansible-galaxy
fi


# Molecule
if command -v molecule >/dev/null 2>&1; then
  MOLECULE_CACHE="$BASH_COMPLETION_CACHE/molecule"

  if [[ ! -s "$MOLECULE_CACHE" ]] ||
     [[ "$(date -r "$MOLECULE_CACHE" +%F 2>/dev/null)" != "$(date +%F)" ]]; then
    _MOLECULE_COMPLETE=bash_source molecule \
      >| "$MOLECULE_CACHE" 2>/dev/null || {
        rm -f "$MOLECULE_CACHE"
      }
  fi

  [[ -r "$MOLECULE_CACHE" ]] && source "$MOLECULE_CACHE"

  unset MOLECULE_CACHE
fi


# Nerdctl fournit parfois directement un fichier.
if [[ -r "$HOME/.local/share/bash-completion/completions/nerdctl" ]]; then
  source "$HOME/.local/share/bash-completion/completions/nerdctl"
fi


# Complétions basées sur un exécutable dédié.
if [[ -x "$HOME/.terragrunt/bin/terragrunt" ]]; then
  complete \
    -C "$HOME/.terragrunt/bin/terragrunt" \
    terragrunt
fi

if [[ -x /usr/local/bin/aws_completer ]]; then
  complete -C /usr/local/bin/aws_completer aws
elif command -v aws_completer >/dev/null 2>&1; then
  complete -C "$(command -v aws_completer)" aws
fi


# ─────────────────────────────────────────────
# ALIASES AND FUNCTIONS
# ─────────────────────────────────────────────

# Eza
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias ll='eza -lahF --icons --color=auto'
else
  alias ls='ls --color=auto'
  alias ll='ls -lahF --color=auto'
fi

alias ..='cd ..'
alias ...='cd ../..'

alias grep='grep --color=auto'
alias ports='ss -tulpn'
alias myip='curl -fsS --max-time 5 ifconfig.me'

if command -v btop >/dev/null 2>&1; then
  alias top='btop'
fi

if command -v batcat >/dev/null 2>&1; then
  alias cat='batcat --style=plain'
elif command -v bat >/dev/null 2>&1; then
  alias cat='bat --style=plain'
fi

alias salut='topgrade --disable containers -c --yes'

setK3S() {
  export KUBECONFIG="/etc/rancher/k3s/k3s.yaml"
}

unsetK3S() {
  export KUBECONFIG="$HOME/.kube/config"
}

please_last() {
  local previous_command

  previous_command="$(fc -ln -1)"
  [[ -n "$previous_command" ]] || return 1

  eval "sudo $previous_command"
}

alias gcl='gitlab-ci-local --home ~/.gitlab-ci-local'


# Kubernetes
alias k='kubectl'

if declare -F __start_kubectl >/dev/null 2>&1; then
  complete -o default -F __start_kubectl k
fi


# Kubeseal
alias kubeseal='kubeseal --cert ~/.kube/sealed-secrets-cert.pem'


# Ansible
alias ansible-env='source ~/.venv/ansible/bin/activate'


# OpenStack
alias os='openstack'

if declare -F _openstack >/dev/null 2>&1; then
  complete -o default -F _openstack os
fi


# ─────────────────────────────────────────────
# FZF
# ─────────────────────────────────────────────
# Une seule source FZF. Les versions récentes fournissent `fzf --bash` ;
# les fichiers sous ~/.fzf/shell restent le fallback pour les anciennes.
if [[ -r "$HOME/.fzf.bash" ]]; then
  source "$HOME/.fzf.bash"
elif command -v fzf >/dev/null 2>&1 && fzf --bash >/dev/null 2>&1; then
  source <(fzf --bash)
else
  [[ -r "$HOME/.fzf/shell/completion.bash" ]] &&
    source "$HOME/.fzf/shell/completion.bash"
  [[ -r "$HOME/.fzf/shell/key-bindings.bash" ]] &&
    source "$HOME/.fzf/shell/key-bindings.bash"
fi

export FZF_DEFAULT_OPTS="
  --height 50%
  --layout=reverse
  --border
  --color='fg:#d0d0d0,bg:#121212,hl:#5f87af'
  --color='fg+:#d0d0d0,bg+:#262626,hl+:#5fd7ff'
  --color='info:#afaf87,prompt:#d7005f,pointer:#af5fff'
  --color='marker:#87ff00,spinner:#af5fff,header:#87afaf'
"


# ─────────────────────────────────────────────
# EXTRA COMPLETION FILES
# ─────────────────────────────────────────────
if [[ -d "$HOME/.bash_completion.d" ]]; then
  for completion_file in "$HOME"/.bash_completion.d/*.bash; do
    [[ -r "$completion_file" ]] && source "$completion_file"
  done

  unset completion_file
fi


# ─────────────────────────────────────────────
# FZF TAB COMPLETION
# ─────────────────────────────────────────────
# Utilise les complétions Bash existantes dans un sélecteur FZF sur Tab.
FZF_TAB_COMPLETION_PROMPT='❯ '
FZF_COMPLETION_AUTO_COMMON_PREFIX=true
FZF_COMPLETION_AUTO_COMMON_PREFIX_PART=true

FZF_TAB_COMPLETION_SCRIPT="$HOME/.local/share/fzf-tab-completion/bash/fzf-bash-completion.sh"
if [[ -r "$FZF_TAB_COMPLETION_SCRIPT" ]]; then
  source "$FZF_TAB_COMPLETION_SCRIPT"
  # Tab reste la complétion Bash rapide et répétable.
  bind '"\t":menu-complete'
  bind '"\e[Z":menu-complete-backward'

  # Ctrl+Espace ouvre explicitement le sélecteur FZF complet.
  bind -x '"\C-@": fzf_bash_completion'
fi
unset FZF_TAB_COMPLETION_SCRIPT


# ─────────────────────────────────────────────
# LOCAL MACHINE CONFIGURATION
# ─────────────────────────────────────────────
if [[ -r "$HOME/.bashrc.local" ]]; then
  source "$HOME/.bashrc.local"
fi

if [[ -r "$HOME/.config/openstack/openrc.sh" ]]; then
  source "$HOME/.config/openstack/openrc.sh"
fi

# ─────────────────────────────────────────────
# FLYLINE
# ─────────────────────────────────────────────
# Charge le builtin Homebrew une fois le prompt, Readline et FZF configurés.
FLYLINE_BUILTIN="/home/linuxbrew/.linuxbrew/opt/flyline/lib/bash/flyline"

if [[ -r "$FLYLINE_BUILTIN" ]] &&
   enable -f "$FLYLINE_BUILTIN" flyline 2>/dev/null; then
  # Prompt compact : contexte à gauche et heure discrète à droite.
  unset PS1_FINAL RPS1_FINAL PS1_FILL_FINAL PROMPT_RULER_FINAL
  PS2='\e[2;35mFLYLINE_PROMPT_LINE_NUMBER│\e[0m '
  RPS1='\e[2m\A\e[0m'

  flyline mouse --mode disabled
  flyline \
    --show-animations true \
    --set-frame-rate 30 \
    --set-idle-frame-rate 1 \
    --send-shell-integration-codes only-prompt-pos \
    --enable-easter-eggs false

  # Palette sombre officielle utilisée dans les démonstrations de Flyline.
  flyline set-style --default-theme dark

  # Le backend natif reste visible avec les terminaux transparents/composités.
  flyline set-cursor --backend terminal --interpolate none
  flyline editor \
    --auto-close-chars true \
    --show-inline-history false \
    --select-with-mouse true
  flyline suggestions \
    --auto-suggest false \
    --num-suggestion-rows 15 \
    --sort-order alphabetical
  flyline suggestions set-fuzzy-mode folder-prefixes

  # Flyline remplace Readline : Ctrl+P/N && bind
  flyline key remap Ctrl+p Up
  flyline key remap Ctrl+n Down
  flyline key bind Ctrl+A always=selectAll

  # Conserve les widgets FZF configurés plus haut.
  declare -F __fzf_history__ >/dev/null 2>&1 &&
    flyline key bind Ctrl+r 'always=runBashCommand(__fzf_history__)'

  declare -F fzf-file-widget >/dev/null 2>&1 &&
    flyline key bind Ctrl+t 'always=runBashCommand(fzf-file-widget)'

  declare -F fzf_bash_completion >/dev/null 2>&1 &&
    flyline key bind Ctrl+Space 'always=runBashCommand(fzf_bash_completion)'

fi

unset FLYLINE_BUILTIN
