# COMPLETIONS
# ─────────────────────────────────────────────
# Cache les completions lentes (une fois par jour)
mkdir -p ~/.bash_cache
_today=$(date +%F)

_regen_completion() {
  local name="$1" cmd="$2"
  local cache="$HOME/.bash_cache/_${name}"
  if [[ ! -f "$cache" || $(date -r "$cache" +%F 2>/dev/null) != "$_today" ]]; then
    eval "$cmd" >| "$cache" 2>/dev/null
  fi
  source "$cache"
}

