# shellcheck shell=bash
# ─────────────────────────────────────────────
# FONCTIONS
# ─────────────────────────────────────────────
_usage() {
  local fn="$1" desc="$2" usage="$3"
  echo -e "$(tput bold)$fn$(tput sgr0) — $desc\nUsage: $usage"
}

_require_args() {
  local expected="$1"
  shift

  (( $# >= expected )) && return 0
  printf "Arguments manquants. Utilise -h pour afficher l’aide.\n" >&2
  return 2
}

_require_command() {
  local name
  for name in "$@"; do
    command -v "$name" >/dev/null 2>&1 && continue
    printf 'Commande requise introuvable : %s\n' "$name" >&2
    return 127
  done
}

_valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

reminder() {
  local filter="${1:-}"
  local cat="${2:-}"

  local -A sections
  sections[kubernetes]="kexec klogs kforward kdebug kdecode"
  sections[réseau]="tcpcheck portscan httpcheck listening waittcp waithttp tlscheck dnscheck"
  sections[git]="gbf glogf gstats gwt gurl"
  sections[fichiers]="ff fcd mkcd croot extract tmpcd"
  sections[processus]="fkill topcpu topmem"
  sections[divers]="retry json path venv serve epoch genpass b64enc b64dec sysinfo meteo reload"

  # Un nom de catégorie seul est accepté : `reminder kubernetes`.
  if [[ -z "$cat" ]]; then
    case "$filter" in
      kubernetes | git | réseau | fichiers | processus | divers)
        cat="$filter"
        filter=""
        ;;
    esac
  fi

  local found=false
  echo ""
  for section in kubernetes git réseau fichiers processus divers; do
    [[ -n "$cat" && "$cat" != "$section" ]] && continue
    local heading=false
    for fn in ${sections[$section]}; do
      [[ -n "$filter" && "$fn" != *"$filter"* ]] && continue

      local -a help_parts=()
      local desc usage
      mapfile -t help_parts < <(
        declare -f "$fn" 2>/dev/null |
          sed -n '/_usage/ {p;q;}' |
          command grep -o '"[^"]*"'
      )

      desc="${help_parts[3]:-sans description}"
      usage="${help_parts[4]:-$fn}"
      desc="${desc#\"}"; desc="${desc%\"}"
      usage="${usage#\"}"; usage="${usage%\"}"

      if [[ "$heading" == false ]]; then
        echo -e "  \e[2m── $section\e[0m"
        heading=true
      fi

      printf "  \e[36m%-12s\e[0m \e[2m%-44s\e[0m \e[90m# %s\e[0m\n" \
        "$fn" "$usage" "$desc"
      found=true
    done
    [[ "$heading" == true ]] && echo ""
  done

  [[ "$found" == false ]] && echo -e "  \e[2mAucune fonction trouvée.\e[0m\n"
  echo -e "  \e[2mreminder [filtre] [catégorie] (alias : myhelp)\e[0m"
  echo ""
}

myhelp() { reminder "$@"; }

# ─────────────────────────────────────────────
# KUBERNETES
# ─────────────────────────────────────────────

kexec() {
  [[ "$1" == "-h" ]] && _usage "kexec" "exec shell sur un pod via fzf" "kexec [namespace]" && return 0
  local ns="${1:--A}"
  local -a scope
  [[ "$ns" == "-A" ]] && scope=(-A) || scope=(-n "$ns")
  local pod container containers
  pod=$(kubectl get pods "${scope[@]}" --no-headers \
    -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name \
    | fzf --prompt="pod > " | awk '{print $1"/"$2}')
  [[ -n "$pod" ]] || return 0

  containers=$(kubectl get pod -n "${pod%/*}" "${pod##*/}" \
    -o jsonpath='{range .spec.containers[*]}{.name}{"\n"}{end}') || return
  if [[ "$containers" == *$'\n'* ]]; then
    container=$(printf '%s\n' "$containers" | sed '/^$/d' | fzf --prompt="container > ")
  else
    container="$containers"
  fi
  [[ -n "$container" ]] || return 0

  kubectl exec -it -n "${pod%/*}" "${pod##*/}" -c "$container" -- \
    sh -c 'if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi'
}

klogs() {
  [[ "$1" == "-h" ]] && _usage "klogs" "tail logs d'un pod via fzf" "klogs [-p] [namespace]" && return 0
  local previous=false
  if [[ "$1" == "-p" ]]; then
    previous=true
    shift
  fi
  local ns="${1:--A}"
  local -a scope log_args=(-f)
  [[ "$ns" == "-A" ]] && scope=(-A) || scope=(-n "$ns")
  [[ "$previous" == true ]] && log_args+=(-p)
  local pod container containers
  pod=$(kubectl get pods "${scope[@]}" --no-headers \
    -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name \
    | fzf --prompt="pod > " | awk '{print $1"/"$2}')
  [[ -n "$pod" ]] || return 0

  containers=$(kubectl get pod -n "${pod%/*}" "${pod##*/}" \
    -o jsonpath='{range .spec.containers[*]}{.name}{"\n"}{end}') || return
  if [[ "$containers" == *$'\n'* ]]; then
    container=$(printf '%s\n' "$containers" | sed '/^$/d' | fzf --prompt="container > ")
  else
    container="$containers"
  fi
  [[ -n "$container" ]] || return 0

  kubectl logs "${log_args[@]}" -n "${pod%/*}" "${pod##*/}" -c "$container"
}

kforward() {
  [[ "$1" == "-h" ]] && _usage "kforward" "port-forward sur un svc via fzf" "kforward [namespace] [port]" && return 0
  local ns="${1:--A}" port="${2:-8080}"
  local -a scope
  [[ "$ns" == "-A" ]] && scope=(-A) || scope=(-n "$ns")
  local svc
  svc=$(kubectl get svc "${scope[@]}" --no-headers \
    -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name \
    | fzf --prompt="svc > " | awk '{print $1"/"$2}')
  [[ -n "$svc" ]] && kubectl port-forward -n "${svc%/*}" "svc/${svc##*/}" "$port"
}

kdebug() {
  [[ "$1" == "-h" ]] && _usage "kdebug" "lance un conteneur éphémère de debug" "kdebug [namespace] [image]" && return 0
  _require_command kubectl fzf || return
  local ns="${1:--A}" image="${2:-busybox:1.36}"
  local -a scope
  [[ "$ns" == "-A" ]] && scope=(-A) || scope=(-n "$ns")
  local pod container containers
  pod=$(kubectl get pods "${scope[@]}" --no-headers \
    -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name |
    fzf --prompt="pod à debugger > " | awk '{print $1"/"$2}')
  [[ -n "$pod" ]] || return 0

  containers=$(kubectl get pod -n "${pod%/*}" "${pod##*/}" \
    -o jsonpath='{range .spec.containers[*]}{.name}{"\n"}{end}') || return
  if [[ "$containers" == *$'\n'* ]]; then
    container=$(printf '%s\n' "$containers" | sed '/^$/d' | fzf --prompt="conteneur cible > ")
  else
    container="$containers"
  fi
  [[ -n "$container" ]] || return 0

  kubectl debug -it -n "${pod%/*}" "${pod##*/}" \
    --image="$image" --target="$container" -- sh
}

kdecode() {
  [[ "$1" == "-h" ]] && _usage "kdecode" "affiche un Secret Kubernetes décodé" "kdecode [namespace]" && return 0
  _require_command kubectl fzf jq || return
  local ns="${1:--A}"
  local -a scope
  [[ "$ns" == "-A" ]] && scope=(-A) || scope=(-n "$ns")
  local secret
  secret=$(kubectl get secrets "${scope[@]}" --no-headers \
    -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name |
    fzf --prompt="secret > " | awk '{print $1"/"$2}')
  [[ -n "$secret" ]] || return 0

  printf '⚠ Affichage en clair du Secret %s\n' "$secret" >&2
  kubectl get secret -n "${secret%/*}" "${secret##*/}" -o json |
    jq -r '.data // {} | to_entries[] | "\(.key)=\(.value | @base64d)"'
}

# ─────────────────────────────────────────────
# RÉSEAU / DEBUG
# ─────────────────────────────────────────────

listening() {
  [[ "$1" == "-h" ]] && _usage "listening" "qui écoute sur un port ?" "listening <port>" && return 0
  _require_args 1 "$@" || return
  ss -tulpn | grep -E ":${1}([[:space:]]|$)"
}

tcpcheck() {
  [[ "$1" == "-h" ]] && _usage "tcpcheck" "test connectivité TCP" "tcpcheck <host> <port>" && return 0
  _require_args 2 "$@" || return
  local host="$1" port="$2"
  _valid_port "$port" || {
    printf 'Port invalide : %s\n' "$port" >&2
    return 2
  }
  timeout 3 bash -c 'cat < /dev/null > "/dev/tcp/$1/$2"' _ "$host" "$port" \
    && echo "✓ $host:$port open" || echo "✗ $host:$port closed"
}

portscan() {
  [[ "$1" == "-h" ]] && _usage "portscan" "scan ports courants sans nmap" "portscan <host>" && return 0
  _require_args 1 "$@" || return
  local host="$1"
  for port in 22 80 443 3306 5432 6379 8080 8443 9090 9200; do
    timeout 1 bash -c 'cat < /dev/null > "/dev/tcp/$1/$2"' _ "$host" "$port" 2>/dev/null \
      && echo "✓ $port open" || echo "✗ $port closed"
  done
}

httpcheck() {
  [[ "$1" == "-h" ]] && _usage "httpcheck" "vérifie les headers HTTP d'une URL" "httpcheck <url>" && return 0
  _require_args 1 "$@" || return
  curl -fsSIL --max-time 10 "$1" | head -20
}

waittcp() {
  [[ "$1" == "-h" ]] && _usage "waittcp" "attend qu'un port TCP réponde" "waittcp <host> <port> [timeout]" && return 0
  _require_args 2 "$@" || return
  _require_command timeout || return
  local host="$1" port="$2" limit="${3:-60}" start=$SECONDS
  _valid_port "$port" || {
    printf 'Port invalide : %s\n' "$port" >&2
    return 2
  }
  [[ "$limit" =~ ^[1-9][0-9]*$ ]] || {
    printf 'Timeout invalide : %s\n' "$limit" >&2
    return 2
  }

  printf 'Attente de %s:%s' "$host" "$port"
  while (( SECONDS - start < limit )); do
    if timeout 1 bash -c 'cat < /dev/null > "/dev/tcp/$1/$2"' _ "$host" "$port" 2>/dev/null; then
      printf '\n✓ %s:%s disponible\n' "$host" "$port"
      return 0
    fi
    printf '.'
    sleep 1
  done
  printf '\n✗ timeout après %ss\n' "$limit" >&2
  return 124
}

waithttp() {
  [[ "$1" == "-h" ]] && _usage "waithttp" "attend qu'une URL HTTP réponde" "waithttp <url> [timeout]" && return 0
  _require_args 1 "$@" || return
  _require_command curl || return
  local url="$1" limit="${2:-60}" start=$SECONDS
  [[ "$limit" =~ ^[1-9][0-9]*$ ]] || {
    printf 'Timeout invalide : %s\n' "$limit" >&2
    return 2
  }

  printf 'Attente de %s' "$url"
  while (( SECONDS - start < limit )); do
    if curl -fsS --max-time 2 -o /dev/null "$url" 2>/dev/null; then
      printf '\n✓ URL disponible\n'
      return 0
    fi
    printf '.'
    sleep 1
  done
  printf '\n✗ timeout après %ss\n' "$limit" >&2
  return 124
}

tlscheck() {
  [[ "$1" == "-h" ]] && _usage "tlscheck" "inspecte le certificat TLS distant" "tlscheck <domaine> [port]" && return 0
  _require_args 1 "$@" || return
  _require_command openssl timeout || return
  local host="$1" port="${2:-443}" pem
  _valid_port "$port" || {
    printf 'Port invalide : %s\n' "$port" >&2
    return 2
  }

  pem=$(timeout 10 openssl s_client -servername "$host" \
    -connect "$host:$port" </dev/null 2>/dev/null) || {
      printf 'Connexion TLS impossible vers %s:%s\n' "$host" "$port" >&2
      return 1
    }
  printf '%s\n' "$pem" | openssl x509 -noout \
    -subject -issuer -dates -ext subjectAltName
}

dnscheck() {
  [[ "$1" == "-h" ]] && _usage "dnscheck" "affiche les principaux enregistrements DNS" "dnscheck <domaine>" && return 0
  _require_args 1 "$@" || return
  _require_command dig || return
  local type answer found=false
  for type in A AAAA CNAME MX TXT; do
    answer=$(dig +noall +answer "$1" "$type")
    [[ -n "$answer" ]] || continue
    printf '\n%s\n%s\n' "$type" "$answer"
    found=true
  done
  [[ "$found" == true ]] || {
    printf 'Aucun enregistrement trouvé pour %s\n' "$1" >&2
    return 1
  }
}

# ─────────────────────────────────────────────
# FICHIERS / NAVIGATION
# ─────────────────────────────────────────────

ff() {
  [[ "$1" == "-h" ]] && _usage "ff" "trouver et ouvrir un fichier via fzf" "ff [dossier]" && return 0
  local root="${1:-.}" file preview
  if command -v batcat >/dev/null 2>&1; then
    preview='batcat --color=always --style=numbers --line-range=:300 -- {}'
  elif command -v bat >/dev/null 2>&1; then
    preview='bat --color=always --style=numbers --line-range=:300 -- {}'
  else
    preview='sed -n "1,300p" -- {}'
  fi

  if command -v fd >/dev/null 2>&1; then
    file=$(fd --type f --hidden --exclude .git . "$root" 2>/dev/null |
      fzf --prompt="file > " --preview "$preview")
  else
    file=$(find "$root" -type f -not -path '*/.git/*' 2>/dev/null |
      fzf --prompt="file > " --preview "$preview")
  fi
  [[ -n "$file" ]] && "${EDITOR:-vim}" "$file"
}

fcd() {
  [[ "$1" == "-h" ]] && _usage "fcd" "cd dans un sous-dossier via fzf" "fcd [dossier]" && return 0
  local root="${1:-.}" dir
  if command -v fd >/dev/null 2>&1; then
    dir=$(fd --type d --hidden --exclude .git . "$root" 2>/dev/null | fzf --prompt="dir > ")
  else
    dir=$(find "$root" -type d -not -path '*/.git/*' 2>/dev/null | fzf --prompt="dir > ")
  fi
  [[ -n "$dir" ]] && cd -- "$dir" || return
}

mkcd() {
  [[ "$1" == "-h" ]] && _usage "mkcd" "crée un dossier puis s'y déplace" "mkcd <dossier>" && return 0
  _require_args 1 "$@" || return
  mkdir -p -- "$1" || return
  cd -- "$1" || return
}

croot() {
  [[ "$1" == "-h" ]] && _usage "croot" "se place à la racine du dépôt Git" "croot" && return 0
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Pas dans un dépôt Git." >&2
    return 1
  }
  cd -- "$root" || return
}

extract() {
  [[ "$1" == "-h" ]] && _usage "extract" "extrait une archive selon son format" "extract <archive> [destination]" && return 0
  _require_args 1 "$@" || return
  local archive="$1" destination="${2:-.}" basename output
  [[ -f "$archive" ]] || {
    printf 'Archive introuvable : %s\n' "$archive" >&2
    return 1
  }
  mkdir -p -- "$destination" || return

  case "$archive" in
    *.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz2 | *.tar.xz | *.txz | *.tar.zst)
      _require_command tar || return
      tar -xf "$archive" -C "$destination"
      ;;
    *.zip)
      _require_command unzip || return
      unzip "$archive" -d "$destination"
      ;;
    *.7z)
      _require_command 7z || return
      7z x "$archive" "-o$destination"
      ;;
    *.rar)
      _require_command unrar || return
      unrar x "$archive" "$destination/"
      ;;
    *.gz | *.bz2 | *.xz)
      basename="${archive##*/}"
      output="$destination/${basename%.*}"
      [[ ! -e "$output" ]] || {
        printf 'Le fichier existe déjà : %s\n' "$output" >&2
        return 1
      }
      case "$archive" in
        *.gz) _require_command gzip || return; gzip -dc -- "$archive" > "$output" ;;
        *.bz2) _require_command bzip2 || return; bzip2 -dc -- "$archive" > "$output" ;;
        *.xz) _require_command xz || return; xz -dc -- "$archive" > "$output" ;;
      esac
      ;;
    *)
      printf "Format d’archive non pris en charge : %s\n" "$archive" >&2
      return 2
      ;;
  esac
}

tmpcd() {
  [[ "$1" == "-h" ]] && _usage "tmpcd" "crée un dossier temporaire et s'y déplace" "tmpcd" && return 0
  local directory
  directory=$(mktemp -d "${TMPDIR:-/tmp}/shell-XXXXXX") || return
  cd -- "$directory" || return
  printf '→ %s\n' "$directory"
}

# ─────────────────────────────────────────────
# PROCESS
# ─────────────────────────────────────────────

fkill() {
  [[ "$1" == "-h" ]] && _usage "fkill" "arrête un processus via fzf" "fkill [-9]" && return 0
  local signal=TERM pid
  [[ "$1" == "-9" ]] && signal=KILL
  pid=$(ps aux | fzf --prompt="process > " --header-lines=1 | awk '{print $2}')
  [[ -n "$pid" ]] && kill -s "$signal" -- "$pid" && echo "→ signal $signal envoyé à $pid"
}

topcpu() {
  [[ "$1" == "-h" ]] && _usage "topcpu" "affiche les processus les plus gourmands en CPU" "topcpu" && return 0
  ps aux --sort=-%cpu | head -11
}

topmem() {
  [[ "$1" == "-h" ]] && _usage "topmem" "affiche les processus les plus gourmands en mémoire" "topmem" && return 0
  ps aux --sort=-%mem | head -11
}

# ─────────────────────────────────────────────
# GIT
# ─────────────────────────────────────────────

gbf() {
  [[ "$1" == "-h" ]] && _usage "gbf" "switch de branche via fzf" "gbf" && return 0
  local branch
  branch=$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes |
    grep -v '/HEAD$' | sort -u | fzf --prompt="branch > ")
  [[ -n "$branch" ]] || return 0

  local local_branch="$branch"
  if git show-ref --verify --quiet "refs/remotes/$branch"; then
    local_branch="${branch#*/}"
  fi

  if git show-ref --verify --quiet "refs/heads/$local_branch"; then
    git switch "$local_branch"
  elif git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
  else
    git switch --track "$branch"
  fi
}

glogf() {
  [[ "$1" == "-h" ]] && _usage "glogf" "git log interactif avec preview diff" "glogf" && return 0
  local commit
  commit=$(git log --oneline --all |
    fzf --preview 'git show --color=always --stat --patch {1}' |
    awk '{print $1}')
  [[ -n "$commit" ]] && git show "$commit"
}

gstats() {
  [[ "$1" == "-h" ]] && _usage "gstats" "stats commits par auteur" "gstats" && return 0
  git shortlog -sn --all
}

# Oh My Bash fournit déjà `gwt` comme alias vers `git worktree`.
# Notre fonction interactive le remplace volontairement.
unalias gwt 2>/dev/null || true
gwt() {
  [[ "$1" == "-h" ]] && _usage "gwt" "gère les worktrees Git avec fzf" "gwt [add <branche> [chemin] | remove]" && return 0
  _require_command git fzf || return
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "Pas dans un dépôt Git." >&2
    return 1
  }

  local action="${1:-use}" branch path repo root
  case "$action" in
    use)
      path=$(git worktree list --porcelain | sed -n 's/^worktree //p' |
        fzf --prompt="worktree > " --preview 'git -C {} status --short --branch')
      [[ -n "$path" ]] || return 0
      cd -- "$path" || return
      ;;
    add)
      _require_args 2 "$@" || return
      branch="$2"
      repo=$(basename "$(git rev-parse --show-toplevel)") || return
      root=$(dirname "$(git rev-parse --show-toplevel)") || return
      path="${3:-$root/${repo}-${branch//\//-}}"
      if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$path" "$branch"
      elif git show-ref --verify --quiet "refs/remotes/$branch"; then
        git worktree add --track -b "${branch#*/}" "$path" "$branch"
      else
        git worktree add -b "$branch" "$path"
      fi
      ;;
    remove)
      path=$(git worktree list --porcelain | sed -n 's/^worktree //p' |
        command grep -vxF "$(git rev-parse --show-toplevel)" |
        fzf --prompt="worktree à supprimer > " --preview 'git -C {} status --short --branch')
      [[ -n "$path" ]] && git worktree remove "$path"
      ;;
    *)
      printf 'Action inconnue : %s (use, add ou remove)\n' "$action" >&2
      return 2
      ;;
  esac
}

gurl() {
  [[ "$1" == "-h" ]] && _usage "gurl" "affiche ou ouvre l'URL du dépôt Git" "gurl [-o]" && return 0
  _require_command git sed || return
  local remote url
  remote=$(git remote get-url origin 2>/dev/null) || {
    echo "Remote origin introuvable." >&2
    return 1
  }
  url=$(printf '%s\n' "$remote" | sed -E \
    -e 's#^git@([^:]+):#https://\1/#' \
    -e 's#^ssh://git@([^/]+)/#https://\1/#' \
    -e 's#^(https?://)[^/@]+@#\1#' \
    -e 's#\.git$##')
  [[ "$url" == http://* || "$url" == https://* ]] || {
    printf 'URL distante non prise en charge : %s\n' "$remote" >&2
    return 1
  }

  if [[ "$1" == "-o" ]]; then
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
      open "$url" >/dev/null 2>&1 &
    else
      echo "Impossible d'ouvrir un navigateur." >&2
      return 127
    fi
  else
    printf '%s\n' "$url"
  fi
}

# ─────────────────────────────────────────────
# DIVERS
# ─────────────────────────────────────────────

retry() {
  [[ "$1" == "-h" ]] && _usage "retry" "relance une commande après un échec" "retry <tentatives> <délai> <commande...>" && return 0
  _require_args 3 "$@" || return
  local attempts="$1" delay="$2" current=1 status
  [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || {
    echo "Le nombre de tentatives doit être un entier positif." >&2
    return 2
  }
  [[ "$delay" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    echo "Le délai doit être un nombre positif de secondes." >&2
    return 2
  }
  shift 2

  while true; do
    "$@" && return 0
    status=$?
    (( current >= attempts )) && return "$status"
    printf 'Échec (%s/%s), nouvel essai dans %ss…\n' "$current" "$attempts" "$delay" >&2
    sleep "$delay"
    ((current++))
  done
}

json() {
  [[ "$1" == "-h" ]] && _usage "json" "formate et colore du JSON avec jq" "json [fichier|texte] (ou stdin)" && return 0
  _require_command jq || return
  if (( $# == 0 )); then
    jq .
  elif (( $# == 1 )) && [[ -f "$1" ]]; then
    jq . -- "$1"
  else
    printf '%s\n' "$*" | jq .
  fi
}

# L'alias `path` d'Oh My Bash fournit une version plus rudimentaire.
unalias path 2>/dev/null || true
path() {
  [[ "$1" == "-h" ]] && _usage "path" "affiche PATH une entrée par ligne" "path" && return 0
  printf '%s\n' "${PATH//:/$'\n'}"
}

venv() {
  [[ "$1" == "-h" ]] && _usage "venv" "crée puis active un environnement Python" "venv [dossier]" && return 0
  _require_command python3 || return
  local directory="${1:-.venv}"
  [[ -d "$directory/bin" ]] || python3 -m venv "$directory" || return
  [[ -r "$directory/bin/activate" ]] || {
    printf 'Environnement invalide : %s\n' "$directory" >&2
    return 1
  }
  # shellcheck disable=SC1090
  source "$directory/bin/activate"
  printf '→ environnement activé : %s\n' "$directory"
}

serve() {
  [[ "$1" == "-h" ]] && _usage "serve" "sert un dossier en HTTP" "serve [port] [dossier]" && return 0
  _require_command python3 || return
  local port="${1:-8000}" directory="${2:-.}"
  _valid_port "$port" || {
    printf 'Port invalide : %s\n' "$port" >&2
    return 2
  }
  [[ -d "$directory" ]] || {
    printf 'Dossier introuvable : %s\n' "$directory" >&2
    return 1
  }
  printf '→ http://127.0.0.1:%s (%s)\n' "$port" "$directory"
  python3 -m http.server "$port" --bind 127.0.0.1 --directory "$directory"
}

epoch() {
  [[ "$1" == "-h" ]] && _usage "epoch" "convertit une date ou un timestamp Unix" "epoch [timestamp|date]" && return 0
  _require_command date || return
  if (( $# == 0 )); then
    date +%s
  elif [[ "$1" =~ ^[0-9]+$ ]] && (( $# == 1 )); then
    date -d "@$1" '+%Y-%m-%d %H:%M:%S %Z'
  else
    date -d "$*" +%s
  fi
}

meteo() {
  [[ "$1" == "-h" ]] && _usage "meteo" "affiche la météo d'une ville" "meteo [ville]" && return 0
  curl -s "wttr.in/${1:-Nantes}?format=3"
}

b64enc() {
  [[ "$1" == "-h" ]] && _usage "b64enc" "encode en Base64" "b64enc [texte] (ou stdin)" && return 0
  if (( $# )); then printf '%s' "$*" | base64; else base64; fi
}

b64dec() {
  [[ "$1" == "-h" ]] && _usage "b64dec" "décode du Base64" "b64dec [texte] (ou stdin)" && return 0
  if (( $# )); then printf '%s' "$*" | base64 -d; else base64 -d; fi
}

genpass() {
  [[ "$1" == "-h" ]] && _usage "genpass" "génère un mot de passe aléatoire" "genpass [longueur]" && return 0
  local length="${1:-32}"
  [[ "$length" =~ ^[1-9][0-9]*$ ]] || {
    echo "La longueur doit être un entier positif." >&2
    return 2
  }
  LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*' < /dev/urandom 2>/dev/null |
    head -c "$length"
  echo
}

sysinfo() {
  [[ "$1" == "-h" ]] && _usage "sysinfo" "affiche un résumé du système" "sysinfo" && return 0
  echo "Hostname : $(hostname)"
  echo "OS       : $(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '\"')"
  echo "Kernel   : $(uname -r)"
  echo "Uptime   : $(uptime -p)"
  echo "CPU      : $(grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)"
  echo "RAM      : $(free -h | awk '/Mem/{print $3"/"$2}')"
  echo "Disk     : $(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')"
  echo "IP       : $(hostname -I | awk '{print $1}')"
}

reload() {
  [[ "$1" == "-h" ]] && _usage "reload" "recharge la configuration Bash" "reload" && return 0
  # shellcheck disable=SC1090
  source "$HOME/.bashrc" && echo "→ .bashrc rechargé"
}
