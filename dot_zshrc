# ─────────────────────────────────────────────
# COMPLETIONS
# ─────────────────────────────────────────────
ZSH_COMPLETION_CACHE="$HOME/.cache/zsh/completions"
# Toute évolution de la mécanique ci-dessous doit invalider les scripts déjà
# générés : cette sentinelle évite de le faire à la main.
ZSH_COMPLETION_CACHE_VERSION=3

if [[ "$(<$ZSH_COMPLETION_CACHE/.version)" != "$ZSH_COMPLETION_CACHE_VERSION" ]] 2>/dev/null; then
  command rm -rf -- "$ZSH_COMPLETION_CACHE"
fi
if [[ ! -d "$ZSH_COMPLETION_CACHE" ]]; then
  command mkdir -p -- "$ZSH_COMPLETION_CACHE"
  print -r -- "$ZSH_COMPLETION_CACHE_VERSION" >| "$ZSH_COMPLETION_CACHE/.version"
fi

# Régénère le script d'un outil, le valide, puis le pré-compile. Appelé
# uniquement lorsqu'un cache manque ou a plus de 24 h, jamais sur le chemin
# normal de démarrage.
_completion_cache_build() {
  local name="$1" cache temporary
  shift

  cache="$ZSH_COMPLETION_CACHE/$name.zsh"
  temporary="$ZSH_COMPLETION_CACHE/.$name.$$.$RANDOM.tmp"

  # Certains générateurs (Scaleway) appellent `compinit` eux-mêmes. Une seconde
  # initialisation réécrit l'intégralité du dump à chaque démarrage, soit près
  # de 200 ms perdues : on neutralise ces appels en position de commande.
  # `zsh -n` ne verifie que la syntaxe : l'aide d'un outil invoque de travers
  # la passe sans broncher. On exige donc la marque d'un vrai script de
  # completion avant d'installer le fichier.
  if "$@" 2>/dev/null |
       sed -E 's/(^|&&|\|\||;)([[:space:]]*)compinit\b/\1\2: neutralise compinit/g' >| "$temporary" &&
     [[ -s "$temporary" ]] &&
     command grep -qE '(^|[[:space:]])(#compdef|compdef|compctl|complete)([[:space:]]|$)' "$temporary" &&
     zsh -n "$temporary" 2>/dev/null &&
     command mv -f -- "$temporary" "$cache"; then
    # `source` privilégie automatiquement le `.zwc` : sourcer les 19 scripts
    # passe de ~230 ms à ~17 ms.
    zcompile -R -- "$cache.zwc" "$cache" 2>/dev/null
    return 0
  fi

  command rm -f -- "$temporary"
  return 1
}

typeset -ga _completion_cache_stale

_completion_cache() {
  local name="$1" cache
  local -a fresh
  shift

  cache="$ZSH_COMPLETION_CACHE/$name.zsh"
  # `mh-24` sélectionne le fichier s'il a moins de 24 h : le test de fraîcheur
  # ne coûte plus les deux `date` que forkait chacun des 19 outils.
  fresh=($cache(Nmh-24))

  if [[ ! -s "$cache" ]]; then
    # Première génération : on n'a pas d'autre choix que d'attendre.
    _completion_cache_build "$name" "$@" || return 0
  elif (( ! ${#fresh} )); then
    # Cache de la veille : on source la version existante et on programme la
    # régénération en tâche de fond. Aucun terminal n'attend un générateur.
    # `"pre${(q)@}"` collerait `pre` au premier element et laisserait les
    # suivants dans des mots separes : on joint explicitement.
    local -a entry
    entry=("$name" "$@")
    _completion_cache_stale+=("${(j: :)${(@q)entry}}")
  fi

  [[ -s "$cache" ]] && source "$cache"
}

