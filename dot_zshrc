  export KUBECONFIG="$HOME/.kube/config"
}

please_last() {
  local previous_command
  previous_command="$(fc -ln -1)"
  [[ -n "$previous_command" ]] && eval "sudo $previous_command"
}


# ─────────────────────────────────────────────
# FZF AND ZLE PLUGINS
# ─────────────────────────────────────────────
export FZF_DEFAULT_OPTS="
  --height 50%
  --layout=reverse
  --border
  --color='fg:#d0d0d0,bg:#121212,hl:#5f87af'
  --color='fg+:#d0d0d0,bg+:#262626,hl+:#5fd7ff'
  --color='info:#afaf87,prompt:#d7005f,pointer:#af5fff'
  --color='marker:#87ff00,spinner:#af5fff,header:#87afaf'
"

if [[ -r "$HOME/.fzf.zsh" ]]; then
  source "$HOME/.fzf.zsh"
elif command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
else
  [[ -r "$HOME/.fzf/shell/completion.zsh" ]] && source "$HOME/.fzf/shell/completion.zsh"
  [[ -r "$HOME/.fzf/shell/key-bindings.zsh" ]] && source "$HOME/.fzf/shell/key-bindings.zsh"
fi

FZF_TAB_PLUGIN="$HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"
if [[ -r "$FZF_TAB_PLUGIN" ]]; then
  source "$FZF_TAB_PLUGIN"
  zstyle ':fzf-tab:*' fzf-command fzf
  zstyle ':fzf-tab:*' fzf-flags --height=50% --layout=reverse --border

  # Tab complète puis parcourt les résultats en ligne, sans menu de sélection.
  bindkey '^I' expand-or-complete
  bindkey '^[[Z' reverse-menu-complete
  if zle -l fzf-tab-complete >/dev/null 2>&1; then
    bindkey '^@' fzf-tab-complete
  fi
fi
unset FZF_TAB_PLUGIN

AUTOPAIR_PLUGIN="$HOME/.local/share/zsh/plugins/zsh-autopair/autopair.zsh"
[[ -r "$AUTOPAIR_PLUGIN" ]] && source "$AUTOPAIR_PLUGIN"
unset AUTOPAIR_PLUGIN

AUTOSUGGEST_PLUGIN="$HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
if [[ -r "$AUTOSUGGEST_PLUGIN" ]]; then
  ZSH_AUTOSUGGEST_USE_ASYNC=true
  # Tous les widgets sont déjà définis avant le premier prompt : une seule
  # liaison suffit et évite d'en reparcourir plus de 200 après chaque commande.
  ZSH_AUTOSUGGEST_MANUAL_REBIND=true
  source "$AUTOSUGGEST_PLUGIN"
fi
unset AUTOSUGGEST_PLUGIN


# ─────────────────────────────────────────────
# LOCAL MACHINE CONFIGURATION
# ─────────────────────────────────────────────
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -r "$HOME/.config/openstack/openrc.sh" ]] && source "$HOME/.config/openstack/openrc.sh"

# Ce plugin doit rester le dernier fichier sourcé pour décorer tous les widgets.
HIGHLIGHT_PLUGIN="$HOME/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -r "$HIGHLIGHT_PLUGIN" ]] && source "$HIGHLIGHT_PLUGIN"
unset HIGHLIGHT_PLUGIN
