setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
# Verrouillage par fcntl : ecriture concurrente sure entre terminaux partageant
# le meme fichier, et plus rapide que le verrou par fichier temporaire.
setopt HIST_FCNTL_LOCK

# Ignore les wrappers techniques injectés par certains lanceurs de terminal.
zshaddhistory() {
  [[ "$1" == "eval -- "\$\'* ]] && return 1
  return 0
}

history-time() {
  if (( $# )); then
    fc -l -t '%d/%m %H:%M  ' "$@"
  else
    fc -l -t '%d/%m %H:%M  ' 1
  fi
}


