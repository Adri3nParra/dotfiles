  _completion_cache molecule env _MOLECULE_COMPLETE=zsh_source molecule

# Les completers AWS et Terragrunt exposent uniquement l'interface Bash `-C`.
autoload -Uz bashcompinit
bashcompinit
# Contrairement a celui de Terraform, le completer de Terragrunt renvoie bien
# ses options. Le chercher dans le PATH plutot qu'a un emplacement fige : une
# installation par Homebrew ou mise passait ici totalement inapercue.
if command -v terragrunt >/dev/null 2>&1; then
  complete -o nospace -C "$(command -v terragrunt)" terragrunt
fi
if command -v aws_completer >/dev/null 2>&1; then
  complete -C "$(command -v aws_completer)" aws
fi
# Terraform et OpenTofu exposent bien une interface `complete -C`, mais leur
# completer ne renvoie que des sous-commandes et ignore les options (`-var`,
# `-target`, ...). La fonction `_terraform` de ~/.zsh_completion.d les couvre.

# Les caches périmés sont reconstruits en une seule passe détachée : le premier
# terminal de la journée démarre aussi vite que les suivants.
if (( ${#_completion_cache_stale} )); then
  {
    # Un seul shell reconstruit à la fois. Sans ce verrou, ouvrir cinq onglets
    # le matin lancerait cinq fois les dix-neuf générateurs, et la contention
    # ralentirait les terminaux suivants. Le verrou est tenu par ce sous-shell
    # et libéré à sa sortie.
    zmodload -F zsh/system b:zsystem 2>/dev/null || exit 0
    zsystem flock -t 0 "$ZSH_COMPLETION_CACHE/.lock" 2>/dev/null || exit 0

    for _stale_entry in "${_completion_cache_stale[@]}"; do
      eval "_completion_cache_build $_stale_entry"
    done
  } &!
fi
unset _completion_cache_stale

