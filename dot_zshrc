# ─────────────────────────────────────────────
# INTERACTIVE SHELL ONLY
# ─────────────────────────────────────────────
[[ -o interactive ]] || return


# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
export EDITOR="vim"
export VISUAL="$EDITOR"

export KUBECONFIG="$HOME/.kube/config"
export GODEBUG="tlsmlkem=0"
export GREP_COLORS='ms=01;31:mc=01;31:sl=:cx=:fn=35:ln=32:bn=32:se=36'

typeset -U path PATH
path=(
  /usr/local/go/bin
  "$HOME/.fzf/bin"
  "$HOME/.terragrunt/bin"
  "$HOME/.local/bin"
  "$HOME/.opencode/bin"
  $path
)

# Homebrew doit précéder l'initialisation des complétions Zsh.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
fpath=("$HOME/.zsh_completion.d" $fpath)


# ─────────────────────────────────────────────
# OH MY ZSH
# ─────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="simple"
plugins=(git aliases)

zstyle ':omz:update' mode disabled
ZSH_DISABLE_COMPFIX=true
COMPLETION_WAITING_DOTS=true

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 -- "Oh My Zsh introuvable : $ZSH/oh-my-zsh.sh"
fi

# Oh My Zsh encode normalement HOST et PWD à chaque prompt pour informer le
# terminal de son dossier courant. Ces valeurs ne changent qu'après un `cd` :
# on garde donc le même signal OSC 7 sans refaire deux substitutions à chaque
# commande.
if (( $+functions[omz_termsupport_cwd] && $+functions[omz_urlencode] )); then
  typeset -g _SHELL_TERM_URL_HOST _SHELL_TERM_URL_PATH

  _shell_termsupport_update_cwd() {
    _SHELL_TERM_URL_HOST="$(omz_urlencode -P "$HOST")" || return
    _SHELL_TERM_URL_PATH="$(omz_urlencode -P "$PWD")" || return
  }

  omz_termsupport_cwd() {
    local url_host="$_SHELL_TERM_URL_HOST"
    [[ -z "$KONSOLE_PROFILE_NAME" && -z "$KONSOLE_DBUS_SESSION" ]] || url_host=""
    printf '\e]7;file://%s%s\e\\' "$url_host" "$_SHELL_TERM_URL_PATH"
  }

  autoload -Uz add-zsh-hook
  add-zsh-hook chpwd _shell_termsupport_update_cwd
  _shell_termsupport_update_cwd
fi

# Garantit un système de complétion fonctionnel même pendant le bootstrap.
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  mkdir -p "$HOME/.cache/zsh"
  compinit -d "$HOME/.cache/zsh/zcompdump"
fi


# ─────────────────────────────────────────────
# SHELL OPTIONS AND KEYMAP
# ─────────────────────────────────────────────
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt CD_SILENT
# La correction des noms de commandes affiche une confirmation `[nyae]` à
# chaque faute de frappe (par exemple `kubecyx` → `kubectx`).
unsetopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt PROMPT_SUBST
setopt AUTO_MENU
unsetopt AUTO_LIST
unsetopt LIST_BEEP

bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^I' expand-or-complete
bindkey '^[[Z' reverse-menu-complete

zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{cyan}%d%f'


# ─────────────────────────────────────────────
# HISTORY
# ─────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

# Ignore les wrappers techniques injectés par certains lanceurs de terminal.
zshaddhistory() {
  [[ "$1" == "eval -- "\$\'* ]] && return 1
  return 0
}

history-time() {
  if (( $# )); then
    fc -l -t '%d/%m %H:%M  ' "$@"
  else
    fc -l -t '%d/%m %H:%M  ' 1
  fi
}


# ─────────────────────────────────────────────
# EXTERNAL TOOLS
# ─────────────────────────────────────────────
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"

  # `hook_env.chpwd_only` rend ce hook precmd inutile. Le retirer évite même
  # le coût du lancement de mise qui ne ferait alors que sortir immédiatement.
  autoload -Uz add-zsh-hook
  add-zsh-hook -d precmd _mise_hook_precmd 2>/dev/null
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if [[ -r "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi


# ─────────────────────────────────────────────
# PROMPT
# ─────────────────────────────────────────────
# Le `✔` large du thème `simple` chevauche la parenthèse avec certaines polices.
ZSH_THEME_GIT_PROMPT_CLEAN=" %{$fg[green]%}✓"

KUBE_PS1_SCRIPT="$HOME/.local/share/kube-ps1/kube-ps1.sh"
if [[ -r "$KUBE_PS1_SCRIPT" ]]; then
  source "$KUBE_PS1_SCRIPT"

  KUBE_PS1_SYMBOL_COLOR=""
  KUBE_PS1_CTX_COLOR=""
  KUBE_PS1_NS_COLOR=""
  KUBE_PS1_PREFIX_COLOR=""
  KUBE_PS1_SUFFIX_COLOR=""
  KUBE_PS1_BG_COLOR=""
  KUBE_PS1_SEPARATOR=" "
  KUBE_PS1_NS_ENABLE=true
  KUBE_PS1_SYMBOL_CUSTOM="☸"
  KUBE_PS1_PREFIX=""
  KUBE_PS1_SUFFIX=""

  _kube_short_cluster() {
    printf '%s\n' "${1#*@}"
  }
  KUBE_PS1_CLUSTER_FUNCTION=_kube_short_cluster

  _kube_effective_namespace() {
    [[ "$1" == "N/A" ]] && printf 'default\n' || printf '%s\n' "$1"
  }
  KUBE_PS1_NAMESPACE_FUNCTION=_kube_effective_namespace
fi
unset KUBE_PS1_SCRIPT

_shell_kube_prompt() {
  (( $+functions[kube_ps1] )) || return
  local kube
  kube="$(kube_ps1)"
  [[ -n "$kube" ]] && print -nr -- " %F{magenta}${kube}%f"
}

# Le thème `simple` possède le prompt de base ; on lui ajoute seulement
# l'indicateur Kubernetes lorsqu'un contexte est disponible.
PROMPT="${PROMPT% }"'$(_shell_kube_prompt) '
PS2='%F{magenta}%_│%f '
# Ne pas afficher le `%` de fin de ligne après une commande interrompue dont
# la sortie ne se termine pas par un retour à la ligne.
PROMPT_EOL_MARK=''


# ─────────────────────────────────────────────
# PERSONAL FUNCTIONS
# ─────────────────────────────────────────────
if [[ -r "$HOME/.config/cloud-profiles/cloud.zsh" ]]; then
  source "$HOME/.config/cloud-profiles/cloud.zsh"
fi

for function_file in "$HOME"/.zsh_functions.d/*.zsh(N); do
  source "$function_file"
done
unset function_file


# ─────────────────────────────────────────────
# COMPLETIONS
# ─────────────────────────────────────────────
ZSH_COMPLETION_CACHE="$HOME/.cache/zsh/completions"
mkdir -p "$ZSH_COMPLETION_CACHE"

_completion_cache() {
  local name="$1" cache temporary today
  shift

  cache="$ZSH_COMPLETION_CACHE/$name.zsh"
  today="$(date +%F)"

  if [[ ! -s "$cache" ]] ||
     [[ "$(date -r "$cache" +%F 2>/dev/null)" != "$today" ]] ||
     ! zsh -n "$cache" 2>/dev/null; then
    temporary="$(mktemp "${cache}.tmp.XXXXXX")" || return 0
    if "$@" >| "$temporary" 2>/dev/null &&
       [[ -s "$temporary" ]] && zsh -n "$temporary" 2>/dev/null; then
      command mv -f -- "$temporary" "$cache"
    else
      command rm -f -- "$temporary"
    fi
  fi

  [[ -r "$cache" ]] && zsh -n "$cache" 2>/dev/null && source "$cache"
}

command -v kubectl >/dev/null 2>&1 && _completion_cache kubectl kubectl completion zsh
command -v helm >/dev/null 2>&1 && _completion_cache helm helm completion zsh
command -v argocd >/dev/null 2>&1 && _completion_cache argocd argocd completion zsh
command -v stern >/dev/null 2>&1 && _completion_cache stern stern --completion zsh
command -v glab >/dev/null 2>&1 && _completion_cache glab glab completion -s zsh
command -v ovhcloud >/dev/null 2>&1 && _completion_cache ovhcloud ovhcloud completion zsh
command -v minikube >/dev/null 2>&1 && _completion_cache minikube minikube completion zsh
command -v kubara >/dev/null 2>&1 && _completion_cache kubara kubara completion zsh
command -v chezmoi >/dev/null 2>&1 && _completion_cache chezmoi chezmoi completion zsh
command -v kube-bench >/dev/null 2>&1 && _completion_cache kube-bench kube-bench completion zsh
command -v task >/dev/null 2>&1 && _completion_cache task task --completion zsh
command -v scw >/dev/null 2>&1 && _completion_cache scw scw autocomplete script shell=zsh
command -v cosign >/dev/null 2>&1 && _completion_cache cosign cosign completion zsh
command -v velero >/dev/null 2>&1 && _completion_cache velero velero completion zsh
command -v dive >/dev/null 2>&1 && _completion_cache dive dive completion zsh
command -v kubecm >/dev/null 2>&1 && _completion_cache kubecm kubecm completion zsh
command -v mise >/dev/null 2>&1 && _completion_cache mise mise completion zsh
command -v kind >/dev/null 2>&1 && _completion_cache kind kind completion zsh
command -v nerdctl >/dev/null 2>&1 && _completion_cache nerdctl nerdctl completion zsh
command -v skopeo >/dev/null 2>&1 && _completion_cache skopeo skopeo completion zsh

if command -v register-python-argcomplete >/dev/null 2>&1; then
  command -v ansible >/dev/null 2>&1 &&
    _completion_cache ansible register-python-argcomplete --shell zsh ansible
  command -v ansible-playbook >/dev/null 2>&1 &&
    _completion_cache ansible-playbook register-python-argcomplete --shell zsh ansible-playbook
  command -v ansible-galaxy >/dev/null 2>&1 &&
    _completion_cache ansible-galaxy register-python-argcomplete --shell zsh ansible-galaxy
fi

command -v molecule >/dev/null 2>&1 &&
  _completion_cache molecule env _MOLECULE_COMPLETE=zsh_source molecule

# Les completers AWS et Terragrunt exposent uniquement l'interface Bash `-C`.
autoload -Uz bashcompinit
bashcompinit
if [[ -x "$HOME/.terragrunt/bin/terragrunt" ]]; then
  complete -C "$HOME/.terragrunt/bin/terragrunt" terragrunt
fi
if command -v aws_completer >/dev/null 2>&1; then
  complete -C "$(command -v aws_completer)" aws
fi
if command -v tofu >/dev/null 2>&1; then
  # OpenTofu expose sa complétion via l'interface Bash `-C`, comme Terraform.
  # Résoudre le chemin au démarrage évite de le figer lors d'une mise à jour.
  complete -o nospace -C "$(command -v tofu)" tofu
fi

(( $+functions[_kubectl] )) && compdef _kubectl k
(( $+functions[_openstack] )) && compdef _openstack os
if (( $+functions[_argocd] )); then
  autoload -Uz _argocd_local
  compdef _argocd_local argocd
fi


# ─────────────────────────────────────────────
