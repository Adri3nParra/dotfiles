#!/usr/bin/env bash
set -euo pipefail

if command -v apt-get >/dev/null; then
  sudo apt-get update
  sudo apt-get install -y \
  {{ range .packages.apt -}}
    {{ . | quote }} \
  {{ end }}
fi

if command -v brew >/dev/null; then
  brew bundle --file=/dev/stdin <<'EOF'
{{ range .packages.brew -}}
brew {{ . | quote }}
{{ end -}}
EOF
fi
